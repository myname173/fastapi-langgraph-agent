{
  "id": null,
  "uid": "vllm-local",
  "title": "vLLM Local Inference (Qwen2.5-0.5B)",
  "tags": [
    "vllm",
    "local",
    "inference"
  ],
  "timezone": "browser",
  "schemaVersion": 30,
  "version": 1,
  "refresh": "10s",
  "description": "Local vLLM service metrics — TTFT, TPOT, throughput, KV-cache usage. Used only by session_naming (lightweight role) via LLM_PROVIDER_OVERRIDES.",
  "panels": [
    {
      "type": "graph",
      "title": "Time To First Token (TTFT) p50 / p95",
      "description": "Latency from request arrival to first generated token. Lower is better.",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "yaxes": [
        {
          "format": "s",
          "label": "seconds"
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Time Per Output Token (TPOT) p50 / p95",
      "description": "Time spent generating each output token (decode step). Lower is better.",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:time_per_output_token_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_per_output_token_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "yaxes": [
        {
          "format": "s",
          "label": "seconds"
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "type": "graph",
      "title": "End-to-End Request Latency p50 / p95",
      "description": "Total request latency from arrival to completion.",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ],
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "yaxes": [
        {
          "format": "s",
          "label": "seconds"
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Token Throughput (tokens/s)",
      "description": "Generation tokens per second (output throughput).",
      "targets": [
        {
          "expr": "sum(rate(vllm:generation_tokens_total[1m]))",
          "legendFormat": "generation (out)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(vllm:prompt_tokens_total[1m]))",
          "legendFormat": "prompt (in)",
          "refId": "B"
        }
      ],
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "yaxes": [
        {
          "format": "short",
          "label": "tokens/s"
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "type": "gauge",
      "title": "GPU KV-Cache Usage %",
      "description": "GPU KV-cache usage. 1 = 100%. High values (>80%) may cause preemption.",
      "targets": [
        {
          "expr": "avg(vllm:gpu_cache_usage_perc) * 100",
          "legendFormat": "KV-cache",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        }
      }
    },
    {
      "type": "graph",
      "title": "Requests Running / Waiting",
      "description": "Running = on GPU; Waiting = queued. Waiting > 0 indicates saturation.",
      "targets": [
        {
          "expr": "sum(vllm:num_requests_running)",
          "legendFormat": "running",
          "refId": "A"
        },
        {
          "expr": "sum(vllm:num_requests_waiting)",
          "legendFormat": "waiting",
          "refId": "B"
        }
      ],
      "datasource": "Prometheus",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "yaxes": [
        {
          "format": "short",
          "min": 0
        },
        {
          "format": "short"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Successful Requests (total)",
      "description": "Cumulative count of successfully processed requests.",
      "targets": [
        {
          "expr": "sum(vllm:request_success_total)",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Preemptions (total)",
      "description": "Cumulative preemption count. Non-zero indicates KV-cache pressure.",
      "targets": [
        {
          "expr": "sum(vllm:num_preemptions_total)",
          "legendFormat": "preemptions",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus",
      "gridPos": {
        "x": 6,
        "y": 24,
        "w": 6,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ],
  "time": {
    "from": "now-1M",
    "to": "now"
  }
}
