# Copy this file to openai_api_key.txt and paste your real DashScope API key.
#   cp secrets/openai_api_key.txt.example secrets/openai_api_key.txt
#   echo -n "sk-your-real-key-here" > secrets/openai_api_key.txt
#
# The file is gitignored — it will never be committed.
# docker-compose.yml mounts it read-only at /run/secrets/openai_api_key
# inside the app container. config.py reads it via OPENAI_API_KEY_FILE.
sk-your-dashscope-api-key-here
