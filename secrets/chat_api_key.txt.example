# Copy this file to chat_api_key.txt and paste your real DeepSeek API key.
#   cp secrets/chat_api_key.txt.example secrets/chat_api_key.txt
#   printf '%s' 'sk-your-real-deepseek-key' > secrets/chat_api_key.txt
#
# Get a key at: https://platform.deepseek.com/api_keys
#
# Used by the CHAT provider: the LLMRegistry default, the mem0
# fact-extraction LLM, and the SDLC coder/planner/reviewer agents.
#
# The file is gitignored — it will never be committed.
# docker-compose.yml mounts it read-only at /run/secrets/chat_api_key
# inside the app container. config.py reads it via CHAT_API_KEY_FILE.
sk-your-deepseek-api-key-here
