# Environment Configuration Example
#
# Copy this file to .env.development / .env.staging / .env.production
# and fill in real values. All four env files are git-ignored.
#
# Every Feature Flag is listed below with its default value and a
# one-line description. Flags defaulting to `false` are opt-in.

# ===================================================================
# Application Settings
# ===================================================================
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# ===================================================================
# CORS Settings
# ===================================================================
# Comma-separated list of allowed origins. Include the UI origin in production.
# Examples:
#   Local dev:     "http://localhost:3000,http://localhost:8000,http://localhost:8501"
#   Production:    "https://api.example.com,https://ui.example.com"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:8501"

# ===================================================================
# Streamlit Web UI Settings
# ===================================================================
# URL the UI uses to reach the backend API.
#   Local dev:              http://localhost:8000
#   Inside docker-compose:  http://app:8000  (compose internal DNS)
UI_API_BASE_URL=http://localhost:8000

# ===================================================================
# Langfuse Settings (LLM observability)
# ===================================================================
# Optional but recommended for production. Set to true and fill keys to enable.
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_BASE_URL="https://jp.cloud.langfuse.com"

# ===================================================================
# LLM Settings
# ===================================================================
# Works with any OpenAI-compatible provider.
# Set OPENAI_BASE_URL + OPENAI_API_KEY + DEFAULT_LLM_MODEL + LLM_MODELS together.
OPENAI_API_KEY="your-llm-api-key"
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-5-mini
# Comma-separated fallback chain. DEFAULT_LLM_MODEL must appear in LLM_MODELS.
LLM_MODELS="gpt-5-mini,gpt-5.4,gpt-5"

# Vision model for multimodal tasks (retrieved dynamically, NOT in fallback chain).
# Set ENABLE_MULTIMODAL=true to activate image analysis.
VISION_MODEL=gpt-4o

# --- Provider presets (uncomment ONE block) ---

# OpenAI (default)
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODELS="gpt-5-mini,gpt-5.4,gpt-5"
# VISION_MODEL=gpt-4o

# Alibaba Bailian (DashScope)
# Get your key at: https://bailian.console.aliyun.com/
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=sk-your-bailian-key
# DEFAULT_LLM_MODEL=qwen-plus
# LLM_MODELS="qwen-plus,qwen-max,qwen-turbo"
# VISION_MODEL=qwen-vl-max

# SiliconFlow
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# DEFAULT_LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro
# LLM_MODELS="deepseek-ai/DeepSeek-V4-Pro,Qwen/Qwen2.5-72B-Instruct"

DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# ===================================================================
# JWT Settings
# ===================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be >= 32 characters in production (startup fails otherwise).
JWT_SECRET_KEY="your-jwt-secret-key-at-least-32-characters-long"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# ===================================================================
# Database Settings
# ===================================================================
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# ===================================================================
# Rate Limiting Settings
# ===================================================================
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# ===================================================================
# SDLC Orchestrator Feature Flags
# ===================================================================
# Master switch for the multi-agent SDLC workflow. When false, the
# classic single-agent chatbot graph is used.
USE_SDLC_ORCHESTRATOR=false

# Workspace sandbox root (relative to project dir). Each task gets
# workspace/{thread_id}/ for file isolation.
SDLC_WORKSPACE_ROOT=workspace
SDLC_MAX_FILE_SIZE=10485760
SDLC_GIT_ENABLED=true
# Comma-separated list of allowed file extensions for write operations.
SDLC_ALLOWED_EXTENSIONS="py,json,md,txt,yml,yaml,toml,js,ts"

# Context window management — prevents token explosion in long tasks.
# Trims older messages when token count exceeds SDLC_MAX_TOKENS.
SDLC_MAX_TOKENS=16000
ENABLE_SDLC_CONTEXT_TRIM=true

# Sandbox backend for code execution tools (run_tests, generate_and_run_script).
# Must be "docker" or "disabled". "host" is forbidden (startup fails).
SANDBOX_BACKEND=docker

# Coder auto-retry limit when post-edit validation fails.
MAX_CODER_RETRIES=3

# ===================================================================
# Security / Audit / Monitoring Flags
# ===================================================================
# Scan file content for sensitive patterns (API keys, passwords, etc.)
# before write operations. Critical issues block the write.
ENABLE_SECURITY_SCAN=true
# Record approval/reject actions with task_id, step, user_id, reason.
ENABLE_AUDIT_LOG=true
# Export additional Prometheus metrics (agent handoffs, cost tracking).
ENABLE_ADVANCED_MONITORING=true

# ===================================================================
# Smart Coder / Knowledge Graph / Smart Search
# ===================================================================
# Inject semantic code-index context into coder prompt.
ENABLE_SMART_CODER=true
# Build a knowledge graph from code structure (AST-based).
ENABLE_KNOWLEDGE_GRAPH=true
KNOWLEDGE_GRAPH_MAX_NODES=1000
KNOWLEDGE_GRAPH_MAX_DEPTH=5
# Hybrid search combining vector + knowledge graph.
ENABLE_SMART_SEARCH=true
SMART_SEARCH_CACHE_TTL_SECONDS=300

# ===================================================================
# Code Index (pgvector-based semantic code search)
# ===================================================================
CODE_INDEX_ENABLED=true
CODE_INDEX_COLLECTION_NAME=code_index
CODE_INDEX_CHUNK_SIZE=100
CODE_INDEX_CHUNK_OVERLAP=20
CODE_INDEX_STRUCTURAL_PARSING=true
CODE_INDEX_MAX_FILE_SIZE=102400

# ===================================================================
# Smart Editing
# ===================================================================
# Apply structured edits (replace/insert/create/delete) via tool calls.
ENABLE_SMART_EDITING=true
SMART_EDIT_MAX_FILES=10
# Auto-flag for human approval when edit count exceeds this threshold.
SMART_EDIT_AUTO_APPROVE_THRESHOLD=3
# Run lint/security validation after applying edits.
ENABLE_POST_EDIT_VALIDATION=true
VALIDATION_TIMEOUT_SECONDS=30

# ===================================================================
# Multimodal (Image Analysis)
# ===================================================================
ENABLE_MULTIMODAL=false
MAX_IMAGE_SIZE_MB=5
MAX_IMAGES_PER_TASK=5
ALLOWED_IMAGE_TYPES="png,jpg,jpeg,webp"
IMAGE_ANALYSIS_CACHE_TTL_SECONDS=600

# ===================================================================
# Resource Quota
# ===================================================================
ENABLE_RESOURCE_QUOTA=true
MAX_WORKSPACE_SIZE_MB=500
MAX_TASKS_PER_USER=20

# ===================================================================
# Script Execution
# ===================================================================
# Allow the coder agent to generate and run scripts in sandbox.
ENABLE_SCRIPT_EXECUTION=true
SCRIPT_TIMEOUT_SECONDS=60
SCRIPT_MAX_RETRIES=3

# ===================================================================
# Optional Enhancements (all default false — opt-in)
# ===================================================================

# --- LLM Cost Tracking ---
# Tracing is always on when ENABLE_ADVANCED_MONITORING=true.
# See docs/llm-cost-tracking.md for cost query examples.

# --- Multi-Agent Handoff Tracing ---
# Record structured handoff events (from_agent → to_agent) in logs.
# Zero overhead when disabled.
ENABLE_HANDOFF_TRACING=true

# --- MCP Client ---
# Connect to external MCP servers and load tools for coder/tester agents.
# Tools are prefixed with "mcp_" to avoid naming conflicts.
# Requires: uv pip install mcp langchain-mcp-adapters (or `uv sync --extra mcp`)
ENABLE_MCP_CLIENT=false
# Comma-separated list of MCP server URLs. All servers share the same
# transport (MCP_DEFAULT_TRANSPORT below). Example for the in-repo
# streamable-http server started by docker-compose:
#   MCP_SERVER_URLS="http://localhost:8002/mcp"
MCP_SERVER_URLS=""
# MCP transport protocol — one of:
#   streamable_http  (default, MCP 2026 production standard; URL form http://host:port/mcp)
#   sse              (legacy Server-Sent-Events; deprecated; URL form http://host:port/sse)
#   stdio            (local subprocess; NOT wired through MCP_SERVER_URLS —
#                    stdio requires command/args fields, use a custom
#                    MultiServerMCPClient setup for this)
MCP_DEFAULT_TRANSPORT=streamable_http

# --- WebSocket Real-Time SDLC ---
# Bidirectional WebSocket endpoint for approve/reject/status commands.
# SSE endpoint /sdlc/stream remains primary; WebSocket is supplementary.
# See docs/websocket.md for protocol details.
ENABLE_WEBSOCKET=false

# --- Knowledge Base (RAG) ---
# Upload documents (PDF/MD/TXT) for RAG-enhanced code generation.
# Uses a separate "knowledge_base" collection with per-user isolation.
# See docs/knowledge-base.md for upload/search API details.
ENABLE_KNOWLEDGE_BASE=false

# --- Async Database ---
# Switch to native async (psycopg3) database driver.
# Default false for zero regression; enable for 3-5x QPS improvement.
ENABLE_ASYNC_DB=false

# --- Prompt Versioning ---
# Pin specific prompt versions per agent. Format: agent_name=version,agent2=v2
# Example: PROMPT_VERSIONS="planner=v2,coder=v3"
# Omitted agents use the default version (latest).
PROMPT_VERSIONS=""

# ===================================================================
# Valkey/Redis Cache (optional — leave VALKEY_HOST empty to disable)
# ===================================================================
# Set VALKEY_HOST=valkey to enable caching using the compose service.
VALKEY_HOST=
VALKEY_PORT=6379
VALKEY_DB=0
VALKEY_PASSWORD=
VALKEY_MAX_CONNECTIONS=20
CACHE_TTL_SECONDS=60

# Semantic cache for LLM responses (requires Valkey/Redis).
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_EMBEDDING_MODEL=text-embedding-v3
SEMANTIC_CACHE_MEMORY_THRESHOLD=0.90
SEMANTIC_CACHE_LLM_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=3600

# ===================================================================
# Profiling Settings (disabled in production)
# ===================================================================
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# ===================================================================
# Logging
# ===================================================================
# LOG_FORMAT: "json" (production) or "console" (development)
LOG_LEVEL=DEBUG
LOG_FORMAT=console
